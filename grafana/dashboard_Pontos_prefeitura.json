        {
          "dataset": "ALTAREDE",
          "datasource": {
            "type": "mysql",
            "uid": "bf5cl81i2yz28d"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  pg.LOGIN AS Login,\r\n  c.NOME AS Nome,\r\n  CONCAT_WS(', ',\r\n    NULLIF(TRIM(CONCAT_WS(' ',\r\n      IF(el.ID IS NULL, c.LOGRADOURO, el.LOGRADOURO),\r\n      IF(el.ID IS NULL, c.ENDERECO,   el.ENDERECO))), ''),\r\n    NULLIF(TRIM(IF(el.ID IS NULL, c.COMPLEMENTO, el.COMPLEMENTO)), '')\r\n  ) AS Rua,\r\n  IF(el.ID IS NULL, c.BAIRRO, el.BAIRRO) AS Bairro,\r\n  IF(el.ID IS NULL, c.CIDADE, el.CIDADE) AS Cidade,\r\n  t.NOME AS Status_Cadastro,\r\n  s.NOME AS Situacao_Login,\r\n  CASE\r\n    WHEN r.RadAcctId IS NOT NULL AND r.AcctStopTime IS NULL THEN 'Online'\r\n    ELSE 'Offline'\r\n  END AS Conexao\r\nFROM ALTAREDE.PROVEDOR_GERAL pg\r\nJOIN ALTAREDE.CLIENTE c\r\n  ON c.COD_CLIENTE = pg.COD_CLIENTE\r\nLEFT JOIN ALTAREDE.TIPOCLIENTE t\r\n  ON t.COD_TIPOCLIENTE = c.COD_TIPOCLIENTE\r\nLEFT JOIN ALTAREDE.STATUS_IP s\r\n  ON s.CODIGO = pg.COD_STATUS\r\nLEFT JOIN ALTAREDE.ENDERECO_LOGIN el\r\n  ON el.ID = (\r\n       SELECT MAX(e2.ID)\r\n       FROM ALTAREDE.ENDERECO_LOGIN e2\r\n       WHERE e2.LOGIN = pg.LOGIN\r\n     )\r\nLEFT JOIN ALTAREDE.radacct r\r\n  ON r.RadAcctId = (\r\n       SELECT MAX(r2.RadAcctId)\r\n       FROM ALTAREDE.radacct r2\r\n       WHERE r2.UserName = pg.LOGIN\r\n     )\r\nWHERE c.CPF = '$prefeitura'\r\n  AND pg.LOGIN NOT LIKE 'SIP\\_%'\r\nORDER BY pg.LOGIN",
          "refId": "A",
          "sql": {
